{
  "name": "page-pulse-frontend",
  "version": "1.0.0",
  "description": "Page Pulse frontend React application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.[t|j]sx?$": "babel-jest"
    },
    "testMatch": [
      "**/tests/**/*.test.[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^axios$": "<rootDir>/tests/__mocks__/axios.js"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.4.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.4.1"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
